            0.0, 1.0);\n    u_xlat16_1 = u_xlat0.y * u_xlat0.x;\n    u_xlat16_0.x
            = texture(_MainTex, vs_TEXCOORD0.xy).w;\n    u_xlat16_4 = u_xlat16_0.x
            * vs_TEXCOORD1.x + (-vs_TEXCOORD1.y);\n    u_xlat16_4 = clamp(u_xlat16_4,
            0.0, 1.0);\n    u_xlat16_0 = vec4(u_xlat16_4) * vs_COLOR0;\n    u_xlat16_4
