            = u_xlat6.xxx * u_xlat16_7.xyz;\n    u_xlat16_1.x = dot(u_xlat3.xyz,
            u_xlat16_1.xyz);\n    u_xlat16_1.x = max(u_xlat16_1.x, 0.0);\n    u_xlat6.x
            = log2(u_xlat16_1.x);\n    u_xlat15 = (-_FaceShininess) + _OutlineShininess;\n   
