            out mediump vec4 SV_Target0;\nvec4 u_xlat0;\nmediump vec4 u_xlat16_0;\nmediump
            vec4 u_xlat16_1;\nfloat u_xlat2;\nmediump vec4 u_xlat16_2;\nvec3 u_xlat3;\nmediump
            vec4 u_xlat16_3;\nvec4 u_xlat4;\nvec4 u_xlat5;\nmediump vec4 u_xlat16_6;\nfloat
            u_xlat7;\nmediump vec3 u_xlat16_8;\nfloat u_xlat9;\nfloat u_xlat10;\nmediump
            float u_xlat16_15;\nvec2 u_xlat16;\nfloat u_xlat24;\nvoid main()\n{\n   
