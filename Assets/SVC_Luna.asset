            + (-u_xlat16_4);\n    u_xlat4 = (-_MaskWipeControl) + 1.0;\n    u_xlat18
            = u_xlat4 * _MaskEdgeSoftness + abs(u_xlat18);\n    u_xlat18 = u_xlat18
            + (-_MaskWipeControl);\n    u_xlat18 = u_xlat18 / _MaskEdgeSoftness;\n   
            u_xlat18 = clamp(u_xlat18, 0.0, 1.0);\n    u_xlat3.xyz = vec3(u_xlat18)
            * u_xlat3.xyz + u_xlat16_2.xyz;\n    u_xlat0.xyz = vec3(u_xlat18) * u_xlat3.xyz;\n   
            u_xlat0.w = u_xlat16_6 * u_xlat18;\n    SV_Target0 = u_xlat0;\n    return;\n}\n\n"
