            main()\n{\n    u_xlat0.x = vs_TEXCOORD2.w;\n    u_xlat0.y = vs_TEXCOORD3.w;\n   
            u_xlat0.z = vs_TEXCOORD4.w;\n    u_xlat0.xyz = (-u_xlat0.xyz) + _WorldSpaceCameraPos.xyz;\n   
