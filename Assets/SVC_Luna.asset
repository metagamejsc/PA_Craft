            vec4 vs_COLOR1;\nhighp vec4 vs_TEXCOORD0;\nmediump vec4 vs_TEXCOORD1;\nmediump
            vec4 vs_TEXCOORD2;\nvec4 u_xlat0;\nvec4 u_xlat1;\nvec4 u_xlat2;\nvec4
            u_xlat3;\nmediump vec4 u_xlat16_3;\nvec4 u_xlat4;\nvec2 u_xlat5;\nfloat
            u_xlat6;\nvec2 u_xlat10;\nfloat u_xlat11;\nfloat u_xlat15;\nbool u_xlatb15;\nvoid
            main()\n{\n    u_xlat0.xy = in_POSITION0.xy + vec2(_VertexOffsetX, _VertexOffsetY);\n   
