            * u_xlat15 + u_xlat11;\n    u_xlatb15 = hlslcc_mtx4x4glstate_matrix_projection[3].w==0.0;\n   
            u_xlat0.x = (u_xlatb15) ? u_xlat0.x : u_xlat6;\n    u_xlat15 = _OutlineSoftness
            * _ScaleRatioA;\n    u_xlat15 = u_xlat15 * u_xlat0.x + 1.0;\n    u_xlat1.x
            = u_xlat0.x / u_xlat15;\n    u_xlat0.x = _OutlineWidth * _ScaleRatioA;\n   
            u_xlat0.x = u_xlat1.x * u_xlat0.x;\n    u_xlatb15 = 0.0>=in_TEXCOORD0.w;\n   
            u_xlat15 = u_xlatb15 ? 1.0 : float(0.0);\n    u_xlat2.x = (-_WeightNormal)
